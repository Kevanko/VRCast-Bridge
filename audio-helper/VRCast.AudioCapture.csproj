<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>VRCast.AudioCapture</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Самодостаточный: у друзей без установленного .NET 9 помощник падал с
         «app-launch-failed» (0x80008096), и захват экрана не запускался вовсе.
         Обрезка только среды выполнения (partial): наш код и NAudio целиком,
         COM-взаимодействие проверено вживую — захват процесса, устройства, увод звука. -->
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DebugType>none</DebugType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="NAudio.Core" HintPath="C:\Users\NM\.nuget\packages\naudio.core\2.3.0\lib\netstandard2.0\NAudio.Core.dll" Private="true" />
    <Reference Include="NAudio.Wasapi" HintPath="C:\Users\NM\.nuget\packages\naudio.wasapi\2.3.0\lib\net9.0-windows10.0.26100\NAudio.Wasapi.dll" Private="true" />
  </ItemGroup>
</Project>

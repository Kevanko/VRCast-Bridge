#!/usr/bin/env bash
# vrcast [start|stop|status|log|install] — запуск VRCast Bridge; без аргументов открывает окно приложения.
root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
port="${VRCAST_PORT:-4717}"
url="http://127.0.0.1:$port"
logfile="${XDG_DATA_HOME:-$HOME/.local/share}/VRCastBridge/vrcast.log"
up() { curl -fs -o /dev/null --max-time 1 "$url/api/status"; }

case "${1:-start}" in
  install) (cd "$root/desktop" && npm install) ;;
  start)
    electron="$root/desktop/node_modules/electron/dist/electron"
    if [ -x "$electron" ]; then
      # Оболочка сама поднимает сервер, трей и окно; повторный запуск лишь показывает окно.
      nohup "$electron" --no-sandbox "$root/desktop" >>"$logfile.shell" 2>&1 &
      echo "VRCast Bridge: $url"
      exit 0
    fi
    echo "Оболочка не установлена (vrcast install) — открываю в Chrome."
    command -v node >/dev/null || { echo "Нужен Node.js 20+" >&2; exit 1; }
    if ! up; then
      mkdir -p "$(dirname "$logfile")"
      (cd "$root" && nohup node src/server.js >>"$logfile.stdout" 2>&1 &)
      for _ in $(seq 50); do up && break; sleep 0.2; done
      up || { echo "Сервер не запустился, смотрите $logfile.stdout" >&2; exit 1; }
    fi
    echo "VRCast Bridge: $url"
    # Окно приложения без вкладок и адресной строки; нет Chromium — обычный браузер.
    for browser in google-chrome google-chrome-stable chromium chromium-browser; do
      if command -v "$browser" >/dev/null; then
        nohup "$browser" --app="$url" --user-data-dir="${XDG_DATA_HOME:-$HOME/.local/share}/VRCastBridge/window" >/dev/null 2>&1 &
        exit 0
      fi
    done
    command -v xdg-open >/dev/null && xdg-open "$url" >/dev/null 2>&1 ;;
  stop) curl -fs -XPOST -H "Content-Type: application/json" -d "{}" "$url/api/shutdown" >/dev/null; pkill -f "desktop/node_modules/electron/dist/electron" ; pkill -f "node src/server.js" && echo "Остановлен" || echo "Не запущен" ;;
  status) up && echo "Работает: $url" || { echo "Не запущен"; exit 1; } ;;
  log) tail -f "$logfile" ;;
  *) echo "Использование: vrcast [start|stop|status|log|install]" >&2; exit 2 ;;
esac
